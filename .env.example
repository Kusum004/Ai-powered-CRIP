# Environment Configuration Template
LOG_LEVEL=INFO

# LLM Provider: 'gemini', 'openai', 'groq', or 'auto' (Falls back to offline synthesizer if no keys provided)
LLM_PROVIDER=gemini

# API Keys (Optional - System works 100% offline if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Streamlit Port
PORT=8501
